# Copy this file to .env and edit the values.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production only: set these when POSTGRES_DB is present.
# POSTGRES_DB=visitra
# POSTGRES_USER=visitra
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# Production only: set False when serving over plain HTTP on a LAN.
# DJANGO_SECURE_SSL_REDIRECT=True

# Production only: SQLite is refused unless this is explicitly enabled.
# DJANGO_ALLOW_SQLITE_PROD=False

# Login throttling.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=900

# Firestore: system of record for business data when enabled.
# The SQL database stays in use for auth/sessions/admin and as a backup mirror.
# FIRESTORE_ENABLED=True
# FIRESTORE_PROJECT=my-gcp-project
# FIRESTORE_DATABASE=(default)
# FIRESTORE_COLLECTION_PREFIX=visitra
# FIRESTORE_BACKEND=firestore
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# For local development against the emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# For tests / offline development without credentials:
# FIRESTORE_BACKEND=memory
